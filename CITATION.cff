cff-version: 1.2.0
message: "If you use MEIDEM in your research, please cite it using the metadata below."

title: "MEIDEM: Multi-grid Epic Interpolator for limb DarkEning Models"
version: 1.0.8
date-released: "2026-05-14"

authors:
  - family-names: Meidem
    given-names: Icaro
    affiliation: "Observatório Nacional"   
    orcid: "https://orcid.org/0000-0001-5331-4810"  

  - family-names: Emilio
